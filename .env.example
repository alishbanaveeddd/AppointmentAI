# M3-M6 environment configuration
# Copy this file to .env before running the API.
# Never commit real secrets in .env.example — placeholder values only.

# Required — M1: environment mode (validated at startup, names the variable on failure)
NODE_ENV=development

# Optional — M1: API listen port (defaults to 8000 when unset)
PORT=8000

# Required — M2: PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres@localhost:5432/appointment_ai_dev

# Required — M3: JWT signing key for authentication (min 32 characters)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Required — M3: Frontend origin for CORS allowlist (must be a valid URL)
FRONTEND_URL=http://localhost:3000

# Required — M6: Groq AI provider key for the backend-only adapter.
# Read from validated server-side env config; never expose to clients or logs.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional — M6: Groq model used for extraction (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b