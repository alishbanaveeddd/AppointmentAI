{
  "name": "appointment-ai",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspace=api && npm run typecheck --workspace=web",
    "lint": "npm run lint --workspace=api && npm run lint --workspace=web",
    "test": "npm run test --workspace=api && npm run test --workspace=web",
    "format": "prettier --write \"api/**/*.{ts,tsx,js,jsx,json}\" \"web/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,tsx,js,json,md,cjs,mjs}\"",
    "format:check": "prettier --check \"api/**/*.{ts,tsx,js,jsx,json}\" \"web/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,tsx,js,json,md,cjs,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/supertest": "^2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "jiti": "^2.7.0",
    "prettier": "^3",
    "prisma": "^5.22.0",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "jsonwebtoken": "^9.0.3"
  }
}
